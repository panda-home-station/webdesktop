{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@api/*": ["src/api/*"],
      "@truenas/api": ["src/truenas/api"],
      "@truenas/stores": ["src/truenas/stores"],
      "@truenas/services": ["src/truenas/services"],
      "@truenas/types": ["src/truenas/types"],
      "@truenas/utils": ["src/truenas/utils"],
      "@truenas/components": ["src/truenas/components"],
      "@truenas/stores/storage-dashboard": ["src/truenas/stores/storage-dashboard.store"],
      "@truenas/stores/pool-manager": ["src/truenas/stores/pool-manager.store"],
      "@truenas/stores/disk": ["src/truenas/stores/disk.store"],
      "@truenas/stores/vdevs": ["src/truenas/stores/vdevs.store"],
      "@truenas/components/dashboard": ["src/truenas/components/dashboard"],
      "@truenas/components/pool-manager": ["src/truenas/components/pool-manager"],
      "@truenas/components/disk-manager": ["src/truenas/components/disk-manager"],
      "@truenas/components/vdevs": ["src/truenas/components/vdevs"],
      "@truenas/components/datasets": ["src/truenas/components/datasets"],
      "@truenas/services/pool": ["src/truenas/services/pool.service"],
      "@truenas/services/disk": ["src/truenas/services/disk.service"],
      "@truenas/services/dataset": ["src/truenas/services/dataset.service"],
      "@truenas/types/pool": ["src/truenas/types/pool-types"],
      "@truenas/types/disk": ["src/truenas/types/disk-types"],
      "@truenas/types/dataset": ["src/truenas/types/dataset-types"],
      "@truenas/types/storage": ["src/truenas/types/storage-types"],
      "@truenas/types/vdev-enum": ["src/truenas/types/vdev-enum-types"],
      "@truenas/types/vdev-status": ["src/truenas/types/vdev-status-enum"],
      "@truenas/types/dedup-enum": ["src/truenas/types/dedup-enum-types"],
      "@truenas/utils/storage": ["src/truenas/utils/storage.utils"],
      "@truenas/utils/topology": ["src/truenas/utils/topology.utils"],
      "@truenas/utils/dataset": ["src/truenas/utils/dataset.utils"]
    }
  },
  "include": ["src"]
}
